# ============================================================
#  CyberShopOS — environment template. THIS FILE IS COMMITTED.
# ============================================================
#
#  It contains no secrets. Copy it to `.env` and fill in your own
#  values. `.env` is gitignored and must never be committed.
#
#      copy .env.example  .env
#
#  Nothing else needs changing — the code reads .env automatically.
# ============================================================


# ---------- DATABASE ----------

# Your SQL Server instance. Do NOT include the database name here.
#   default instance (MSSQLSERVER):   localhost
#   named instance (Express):         localhost\SQLEXPRESS
#   a machine on the network:         DESKTOP-ABC123
DB_SERVER=localhost

# The database name.
DB_DATABASE=comshop


# ---------- AUTHENTICATION ----------

# LEAVE BOTH BLANK to use Windows Authentication — PHP connects as the
# logged-in Windows account and no password exists anywhere in the project.
DB_USERNAME=
DB_PASSWORD=

# For SQL Server Authentication, set both. Never commit a filled-in .env.
# DB_USERNAME=sa
# DB_PASSWORD=


# ---------- FRONTEND ORIGIN (CORS) ----------

# The Vite dev server origin allowed to call the API with credentials.
FRONTEND_ORIGIN=http://localhost:5173


# ---------- API PORT ----------

# The port `php -S` listens on.
API_PORT=8000
